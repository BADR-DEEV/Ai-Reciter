NEXT_PUBLIC_RECITER_WS=ws://127.0.0.1:8000/ws/recite
# 1 shows the /dev page (model specs, data sources) and a Dev link in the header.
NEXT_PUBLIC_DEV_MODE=0
# A fresh clone has no Quran cache, tajweed draft or reader recordings (~330 MB from Hugging Face).
# The web server sets them up in the background when it starts (web/lib/first-run.ts).
# 0 = skip; the studio then offers a "Download reader audio" button where audio is missing.
RATTIL_AUTO_SETUP=1
# Python with huggingface_hub and an `hf auth login` that can read Mathani-Ayat (default: python3).
# RATTIL_PYTHON=python3
