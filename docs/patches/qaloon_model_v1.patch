@@ -152,6 +152,12 @@ def normalize_quran_for_asr(text: str) -> str:
     text = re.sub(r"[\u0660-\u0669\u06F0-\u06F9\d]", "", text)
     text = fix_combining_hamza(text)
     text = text.replace("ے", "ي").replace("ی", "ي").replace("ک", "ك")
+    # A ya carrying a fatha before a dagger alif is a consonant followed by a long
+    # a (القِيَٰمَة -> القيامة, ءَايَٰت -> ءايات); only an unvowelled ya is a seat for
+    # the alif (أَتَيٰكَ -> اتاك, below). At the start of a word it is the vocative
+    # particle, which the Uthmani script joins to its noun: يَٰٓأَيُّهَا -> يا ايها.
+    text = re.sub(r"(^|\s)([وف][\u064B-\u0652]*)?ي(\u0651?\u064E\u0651?)\u0670", r"\1\2ي\3ا ", text)
+    text = re.sub(r"ي(\u0651?\u064E\u0651?)\u0670", r"ي\1ا", text)
     text = re.sub(r"[\u06D6-\u06ED\u06EE-\u06EF\u08F0-\u08F3]", "", text)
     text = re.sub(r"[\u0610-\u061A\u064B-\u065F\u0674]", "", text)
     text = text.replace("ـ", "")
